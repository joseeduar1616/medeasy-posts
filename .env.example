# Variáveis do Portal MedEasy. Só nomes e descrições: os valores ficam nos secrets do GitHub e do Cloudflare, nunca no repositório.
# Para rodar à mão, copie para .env (que o git ignora) e preencha. O site em si não lê nada daqui: ele é estático e público.

# ---------- Build do portal (scripts/portal/build.mjs) e workflows do GitHub ----------
# Senha da equipe. Cifra portal/data (equipe, clientes e admin) e abre o extras.json. Secret PORTAL_SENHA no GitHub.
PORTAL_SENHA=
# Senha antiga de administrador (opcional). Secret PORTAL_SENHA_ADMIN.
PORTAL_SENHA_ADMIN=
# Token da conexão "Portal MedEasy" do Notion. O build só lê. Secret NOTION_TOKEN.
NOTION_TOKEN=
# Id ou link da base "Controle cliente" no Notion. Secret NOTION_DB.
NOTION_DB=
# Opcionais do build
# Pasta de saída dos dados cifrados (padrão portal/data). Os testes usam uma pasta temporária.
PORTAL_SAIDA=
# Parte do mentor no valor total (padrão 0.6).
PORTAL_PCT_MENTOR=
# 1 volta a usar a fórmula "Valor para mentor" do Notion.
PORTAL_USAR_FORMULA=
# 1 volta a pagar o corretor à parte.
PORTAL_CORRETOR_SEPARADO=
# Endereço da ponte para scripts/portal/teste/gemini-ponte.mjs (padrão o de scripts/portal/ponte.txt).
PONTE=

# ---------- Publicação da ponte (.github/workflows/portal-ponte.yml) ----------
# Token do Cloudflare com permissão de publicar Workers. Secret CLOUDFLARE_API_TOKEN.
CLOUDFLARE_API_TOKEN=
# Conta do Cloudflare. Secret CLOUDFLARE_ACCOUNT_ID.
CLOUDFLARE_ACCOUNT_ID=

# ---------- Ponte (worker/, Cloudflare Worker) ----------
# Secrets do Worker (wrangler secret put NOME). Os mesmos nomes, mas guardados no Cloudflare.
#   PORTAL_SENHA        a mesma senha da equipe
#   PORTAL_SENHA_ADMIN  opcional
#   NOTION_TOKEN        token do Notion com permissão de escrita
#   GITHUB_TOKEN        token fine-grained com Actions: write no repositório, para pedir a sincronização
#   GEMINI_API_KEY      chave da API do Gemini (o workflow da ponte copia do secret de mesmo nome no GitHub)
# Variáveis sem segredo ficam em worker/wrangler.toml: GITHUB_REPO, TRIAGEM_DB, CLIENTES_DB, SITE, ORIGEM.
# Opcionais: ADMINS (padrão "jose,eduardo"), FEEDBACK_DB, GEMINI_MODEL, GEMINI_MODEL_RAPIDO.
